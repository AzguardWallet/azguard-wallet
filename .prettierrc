{
	"useTabs": true,
	"tabWidth": 4,
	"semi": false,
	"singleQuote": false,
	"trailingComma": "all",
	"arrowParens": "avoid",
	"printWidth": 120,
	"endOfLine": "lf",
	"overrides": [
		{
			"files": [
				"src/content-script/**/*",
				"src/offscreen/**/*",
				"src/wallet/**/*",
				"tests/**/*"
			],
			"options": {
				"useTabs": false,
				"semi": true
			}
		}
	]
}
